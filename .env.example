# ---------------------------------------------------------------------------
# Northern Trails — every setting is optional.
# With an empty .env the app runs fully on its seeded data layer.
# Add a key and that subsystem switches to live. Check /api/health to see
# which mode each one is in.
# ---------------------------------------------------------------------------

# --- AI assistant ----------------------------------------------------------
# Without this the assistant uses its deterministic grounded composer.
# Retrieval, citations and refusals are identical either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Gemini 3.x reasoning budget and answer length. The defaults suit the
# assistant's short, grounded answers.
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=2048

# --- Package admin (/admin) ------------------------------------------------
# Shared secret for the admin screen that adds and edits tour packages.
# Unset = the admin screen is switched off. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# --- Photos and restaurants ------------------------------------------------
# Optional. Without a key, destination photos come from Wikimedia Commons
# (free, credited, no key). unsplash.com/developers -> "Access Key".
UNSPLASH_ACCESS_KEY=
# Optional. Without a key, restaurants come from OpenStreetMap via the
# Overpass API (free, no key). Google Cloud -> "Places API (New)".
GOOGLE_PLACES_API_KEY=
# Overpass mirrors, tried in order.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Set to 0 to stop photo/restaurant lookups calling out (the tests do this).
LOOKUPS_ENABLED=1

# --- Database --------------------------------------------------------------
# Unset = in-memory. Set = PostgreSQL + PostGIS (tables and seed auto-created).
# Local: docker compose up db, then use the URL below.
# DATABASE_URL=postgresql://northern:northern@localhost:5432/northern_trails
DATABASE_URL=
DB_ECHO=0

# --- Live conditions -------------------------------------------------------
# openweathermap.org/api — free tier is enough (current + 5day/3h).
OPENWEATHER_API_KEY=
POLL_ENABLED=1
POLL_WEATHER_MINUTES=20
POLL_HAZARD_MINUTES=30
POLL_ROAD_MINUTES=15
# NHA blocks automated requests (HTTP 403) from servers. Point this at a
# reachable mirror or district-admin page and the parser will use it.
NHA_URL=https://nha.gov.pk/en/road-conditions/

# --- Firebase phone auth (OTP) ---------------------------------------------
# Firebase console > Project settings. Only the public project id is needed;
# the backend verifies ID tokens against Google's public certificates.
FIREBASE_PROJECT_ID=
# Set to 1 to reject unauthenticated calls on protected routes.
AUTH_REQUIRED=0

# --- Firebase Cloud Messaging ----------------------------------------------
# Service-account JSON: either an absolute path or the raw JSON itself.
FCM_SERVICE_ACCOUNT_JSON=

# --- Payments --------------------------------------------------------------
# mock | jazzcash | easypaisa. Falls back to mock if credentials are missing.
PAYMENTS_PROVIDER=mock
PAYMENTS_RETURN_URL=http://localhost:5173/pay/return

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# --- Frontend (Vite, build-time) -------------------------------------------
# Needed only when the SPA is hosted separately from the API (e.g. Firebase
# Hosting + Render). Same-origin Docker deploys can leave it blank.
# These are baked into the public JavaScript bundle — never put a secret
# key in a VITE_ variable. Every secret above stays on the backend.
VITE_API_BASE=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_VAPID_KEY=

# --- Local Auth emulator (development only) --------------------------------
# Runs the real Firebase Auth software locally: full phone-OTP flow with no
# SMS, no billing and no console setup. Start it with ./scripts/emulator.sh
# and set BOTH variables. Leave them blank to use the real Firebase project.
#   FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099        (backend)
#   VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099   (frontend)
FIREBASE_AUTH_EMULATOR_HOST=
VITE_FIREBASE_AUTH_EMULATOR_HOST=

# --- CORS ------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,https://northern-trails-fyp.web.app,https://northern-trails-fyp.firebaseapp.com
